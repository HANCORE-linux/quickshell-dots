#!/usr/bin/env python3
"""Read BlueZ device state with one ObjectManager D-Bus call."""

import json
import subprocess


def value(properties, key, default=None):
    item = properties.get(key)
    if not isinstance(item, dict):
        return default
    return item.get("data", default)


try:
    result = subprocess.run(
        [
            "busctl", "--json=short", "call", "org.bluez", "/",
            "org.freedesktop.DBus.ObjectManager", "GetManagedObjects",
        ],
        check=True,
        capture_output=True,
        text=True,
        timeout=5,
    )
    objects = json.loads(result.stdout)["data"][0]
except (KeyError, OSError, subprocess.SubprocessError, ValueError):
    print(json.dumps({"powered": False, "devices": []}))
    raise SystemExit(0)

powered = any(
    value(interfaces.get("org.bluez.Adapter1", {}), "Powered", False)
    for interfaces in objects.values()
)
devices = []
if powered:
    for interfaces in objects.values():
        device = interfaces.get("org.bluez.Device1")
        if not device:
            continue

        battery = interfaces.get("org.bluez.Battery1", {})
        address = value(device, "Address", "")
        devices.append(
            {
                "connected": bool(value(device, "Connected", False)),
                "paired": bool(value(device, "Paired", False)),
                "rssi": value(device, "RSSI"),
                "battery": value(battery, "Percentage", -1),
                "icon": value(device, "Icon", ""),
                "mac": address,
                "name": value(device, "Alias") or value(device, "Name") or address,
            }
        )

print(json.dumps({"powered": powered, "devices": devices}, ensure_ascii=False))
